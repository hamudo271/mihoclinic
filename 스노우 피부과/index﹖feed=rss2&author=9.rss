		<link>https://dongtan-snow.com/?p=7195&#038;utm_source=rss&#038;utm_medium=rss&#038;utm_campaign=%25eb%258f%2599%25ed%2583%2584%25ec%258a%25a4%25eb%2585%25b8%25ec%259a%25b0%25ec%259d%2598%25ec%259b%2590-%25ec%25a0%25a0%25ed%258b%2580%25eb%25a7%25a5%25ec%258a%25a4%25ed%2594%2584%25eb%25a1%259c%25ed%2594%258c%25eb%259f%25ac%25ec%258a%25a4-%25ec%2584%25a0%25ed%2583%259d-%25ec%259d%25b4%25ec%259c%25a0</link>
		
		<dc:creator><![CDATA[동탄스노우]]></dc:creator>
