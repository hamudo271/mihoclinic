{"id":4392,"date":"2023-11-29T15:47:37","date_gmt":"2023-11-29T06:47:37","guid":{"rendered":"https:\/\/snowdt.cafe24.com\/?p=4392"},"modified":"2025-09-09T16:32:19","modified_gmt":"2025-09-09T07:32:19","slug":"2-%eb%a6%ac%ec%a5%ac%eb%9e%80-%ec%a7%84%ec%a7%9c-%eb%a7%8e%ec%9d%b4-%eb%b0%9b%ec%95%84-%eb%b3%b8-%ec%9d%98%ec%82%ac%ea%b0%80-%eb%93%a4%eb%a0%a4%ec%a3%bc%eb%8a%94-%ec%9d%b4%ec%95%bc%ea%b8%b0","status":"publish","type":"post","link":"https:\/\/dongtan-snow.com\/?p=4392","title":{"rendered":"\ub9ac\uc96c\ub780, \uc9c4\uc9dc \ub9ce\uc774 \ubc1b\uc544 \ubcf8 \uc758\uc0ac\uac00 \ub4e4\ub824\uc8fc\ub294 \uc774\uc57c\uae30"},"content":{"rendered":"<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7241\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ub9ac\uc96c\ub780-1024x1024.jpg\" alt=\"\" width=\"700\" height=\"700\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ub9ac\uc96c\ub780-1024x1024.jpg 1024w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ub9ac\uc96c\ub780-300x300.jpg 300w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ub9ac\uc96c\ub780-150x150.jpg 150w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ub9ac\uc96c\ub780-768x768.jpg 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ub9ac\uc96c\ub780-200x200.jpg 200w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ub9ac\uc96c\ub780-140x140.jpg 140w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ub9ac\uc96c\ub780-100x100.jpg 100w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ub9ac\uc96c\ub780-500x500.jpg 500w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ub9ac\uc96c\ub780-350x350.jpg 350w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ub9ac\uc96c\ub780-1000x1000.jpg 1000w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ub9ac\uc96c\ub780-800x800.jpg 800w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ub9ac\uc96c\ub780.jpg 1280w\" sizes=\"auto, (max-width: 700px) 100vw, 700px\" \/><\/p>\n<p>\uc548\ub155\ud558\uc138\uc694.<br \/>\n\ub3d9\ud0c4\uc2a4\ub178\uc6b0\uc758\uc6d0 \uc758\ub8cc\uc9c4 \uc785\ub2c8\ub2e4.<\/p>\n<p>\ud604\uc9c1\uc5d0 \uc788\uc73c\uba74\uc11c \uc800\ub9cc\uc758 \ud790\ub9c1\uc774 \uc788\ub2e4\uba74, \ubc14\ub85c \ud1f4\uadfc \ud6c4 \uc2dc\uc220\uc744 \ubc1b\ub294 \uac83\uc778\ub370\uc694.<\/p>\n<p>\uadf8 \uc911\uc5d0\uc11c\ub3c4 \uac00\uc7a5 \uc560\uc815\ud558\ub294 \uc2dc\uc220\uc774 \uc788\ub2e4\uba74, 20\ub300\ubd80\ud130 \uc548\ud2f0\uc5d0\uc774\uc9d5\uc744 \uc704\ud574 \uafb8\uc900\ud788 \ubc1b\uc544\uc628 \uc774 <strong>\u2018\ub9ac\uc96c\ub780\u2019<\/strong> \uc785\ub2c8\ub2e4.<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7246\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\ub9ac\uc96c\ub780-\uc5e0\ubcf4-780x1024.png\" alt=\"\" width=\"400\" height=\"525\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\ub9ac\uc96c\ub780-\uc5e0\ubcf4-780x1024.png 780w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\ub9ac\uc96c\ub780-\uc5e0\ubcf4-229x300.png 229w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\ub9ac\uc96c\ub780-\uc5e0\ubcf4-768x1008.png 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\ub9ac\uc96c\ub780-\uc5e0\ubcf4.png 960w\" sizes=\"auto, (max-width: 400px) 100vw, 400px\" \/><\/p>\n<p>\ub9ac\uc96c\ub780\uc740 \u2018<strong>\ud3f4\ub9ac\ub274\ud074\ub808\uc624\ud0c0\uc774\ub4dc(PN)<\/strong>\u2019 \ub77c\ub294 \uc5f0\uc5b4\uc758 DNA \uc131\ubd84\uc744 \ucd94\ucd9c\ud55c \uc81c\ud488\uc73c\ub85c, \uc774\ub97c \ud53c\ubd80 \uc9c4\ud53c\uce35\uc5d0 \uc8fc\uc785\ud568\uc73c\ub85c\uc368 \uc9c4\ud589\ub429\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>\ud53c\ubd80\ub294 \uc2e0\uccb4\uc758 \uac00\uc7a5 \uc678\uce21\uc744 \ubcf4\ud638\ud558\ub294 \uc870\uc9c1\uc73c\ub85c, \ud56d\uc2dc \uc218\ub9ce\uc740 \uc790\uadf9\uc5d0 \ub178\ucd9c\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uc774\ub85c \uc778\ud574 \uc790\uc678\uc120, \ub9c8\ucc30, \uc5f4 \uc790\uadf9 \ub4f1\uc5d0 \uc758\ud574 \uc9c0\uc18d\uc801\uc73c\ub85c \uc190\uc0c1\uc744 \ubc1b\uac8c \ub418\uace0, \uc774 \uc190\uc0c1\uc774 \ubcf5\uad6c\ub418\uc9c0 \uc54a\uc73c\uba74 \uc8fc\ub984, \ud0c4\ub825\uc800\ud558, \ud53c\ubd80 \uacb0 \uc545\ud654 \ub4f1 \ub178\ud654\uc758 \uc9d5\ud6c4\uac00 \uc810\ucc28 \ub098\ud0c0\ub098\uac8c \ub418\uc8e0.<\/p>\n<p>&nbsp;<\/p>\n<p>\ub9ac\uc96c\ub780\uc758 PN \uc131\ubd84\uc774 \ud53c\ubd80\uc5d0 \ub4e4\uc5b4\uac00\uac8c \ub418\uba74 \uc870\uc9c1\ubc18\uc751\uc744 \ud1b5\ud558\uc5ec, \uc704\uc640 \uac19\uc774 <span style=\"color: #333399;\">\uc190\uc0c1\ub41c \ud53c\ubd80\uc870\uc9c1\uc744 \uc7ac\uc0dd\/\ubcf5\uad6c<\/span> \uc2dc\ucf1c\uc90d\ub2c8\ub2e4.<\/p>\n<p>\uc774\ub97c \ud1b5\ud574, \uc548\ud2f0\uc5d0\uc774\uc9d5 \ucc28\uc6d0\uc5d0\uc11c \ub3c4\uc6c0\uc774 \ub420 \ubfd0\ub9cc \uc544\ub2c8\ub77c, <span style=\"color: #333399;\">\uc794\uc8fc\ub984, \ud0c4\ub825, \uad11\ucc44 \ub4f1 \uc804\ubc18\uc801\uc778 \ud53c\ubd80 \ud658\uacbd\uc744 \uac1c\uc120<\/span>\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7239\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/KakaoTalk_20240508_175836545.gif\" alt=\"\" width=\"700\" height=\"467\" \/><\/p>\n<p>\uc704\uc640 \uac19\uc774 \ud53c\ubd80\uc758 \uc804\ubc18\uc801\uc778 \ucee8\ub514\uc158\uc744 \ub04c\uc5b4\uc62c\ub824\uc8fc\ub294 \ub9cc\ud07c, \uc6e8\ub529, \ucd2c\uc601 \ub4f1 \uc911\uc694\ud55c \ud589\uc0ac\ub97c \uc55e\ub450\uace0 \uc9c4\ud589\ud558\uc2dc\ub294 \uacbd\uc6b0\ub3c4 \ub9ce\uc740\ub370\uc694.<\/p>\n<p>&nbsp;<\/p>\n<p><strong>\u2018\uc5bc\uad74\uc5d0\uc11c \uad11\uc774 \ub09c\ub2e4.\u2019 \u2018\ud654\uc7a5\uc774 \uc798 \uba39\ub294\ub2e4.\u2019<\/strong><\/p>\n<p>\ub77c\uace0 \ud45c\ud604\ud574\uc8fc\uc2dc\ub294 \uac83\ucc98\ub7fc, \uc800 \uac19\uc740 \uacbd\uc6b0\uc5d0\ub3c4 \uc6e8\ub529\uc744 \uc55e\ub454 \uce5c\uad6c\uac00 \uc788\uc73c\uba74 \ud544\uc218\ucf54\uc2a4\ub85c \ucd94\ucc9c\uc744 \ud558\uba70 \uacb0\ud63c \uc120\ubb3c\ub85c \ud574\uc8fc\uae30\ub3c4 \ud55c\ub2f5\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>\ub9ac\uc96c\ub780 \uc2dc\uc220 \ubc29\ubc95\uc740 \ud06c\uac8c \ub450 \uac00\uc9c0\uac00 \uc788\uc2b5\ub2c8\ub2e4.<br \/>\n<span style=\"color: #333399;\">\uc190\uc73c\ub85c \uc9c1\uc811 \uc8fc\uc785\ud558\ub294 \ubc29\ubc95<span style=\"color: #000000;\">\uacfc,<\/span> \uc2a4\ud0a8\ubd80\uc2a4\ud130 \uc804\uc6a9 \uc7a5\ube44\ub97c \uc774\uc6a9\ud558\ub294 \ubc29\ubc95<\/span>\uc785\ub2c8\ub2e4.<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7243\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc7a5\ube44-1024x683.jpg\" alt=\"\" width=\"700\" height=\"467\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc7a5\ube44-1024x683.jpg 1024w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc7a5\ube44-300x200.jpg 300w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc7a5\ube44-768x512.jpg 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc7a5\ube44-800x533.jpg 800w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc7a5\ube44-900x600.jpg 900w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc7a5\ube44-675x450.jpg 675w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc7a5\ube44.jpg 1920w\" sizes=\"auto, (max-width: 700px) 100vw, 700px\" \/><\/p>\n<p>\uc800\ud76c \uc758\uc6d0\uc5d0\uc11c\ub294 \uc190\uc8fc\uc0ac\uc640 \ub354\ub9c8\uc0e4\uc778\ud504\ub85c \uc7a5\ube44\uc8fc\uc0ac \ub450 \uac00\uc9c0 \ubaa8\ub450 \uc9c4\ud589\ud558\uba70, \ud658\uc790\ubd84\uc758 \ud53c\ubd80 \uc0c1\ud0dc\uc640 \uc2dc\uc220 \ubd80\uc704\uc5d0 \ub9de\ucd94\uc5b4 \uc801\ud569\ud55c \ubc29\ubc95\uc744 \uad8c\ud574\ub4dc\ub9bd\ub2c8\ub2e4.<\/p>\n<p><strong><span style=\"color: #000000;\">1.\uae30\uacc4\uc8fc\uc0ac(\ub354\ub9c8\uc0e4\uc778\ud504\ub85c)<\/span><\/strong> : <span style=\"color: #333399;\">\uc9c4\ud53c 1~2mm \uae4a\uc774\uc5d0 \uc77c\uc815\ub7c9\uc744 \uade0\uc77c\ud558\uac8c \uc8fc\uc785<\/span>\ud560 \uc218 \uc788\uc5b4 <span style=\"color: #333399;\">\uc774\ub9c8\u00b7\ud131\u00b7\ubcfc\ucc98\ub7fc \ub113\uc740 \ubd80\uc704\uc5d0 \uc801\ud569<\/span>\ud569\ub2c8\ub2e4. \ud53c\ubd80\ub97c \uc778\uc2dd\ud574 \uc74c\uc555\uc73c\ub85c \ub2f9\uaca8 \uc815\ud655\ud55c \uae4a\uc774\uc5d0 \uc57d\ubb3c\uc744 \uc804\ub2ec\ud558\uae30 \ub54c\ubb38\uc5d0 \uc77c\uc815\ud558\uace0 \uc548\uc815\uc801\uc778 \ud6a8\uacfc\ub97c \uae30\ub300\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p><strong><span style=\"color: #000000;\">2.\uc190\uc8fc\uc0ac<\/span><\/strong><br \/>\n<span style=\"color: #333399;\">\uc6d0\ud558\uc2dc\ub294 \ubd80\uc704 \uc9d1\uc911 \uc2dc\uc220\uc5d0 \uc720\uc6a9<\/span>\ud560 \uc218 \uc788\uc73c\uba70, <span style=\"color: #333399;\">\ub208\uac00 \uac00\uae4c\uc774 \ub4f1 \uc881\uace0 \uc12c\uc138\ud55c \ubd80\uc704\uc5d0 \ud65c\uc6a9<span style=\"color: #000000;\">\ub418\uae30 \ud3b8\ub9ac\ud574 \ub514\ud14c\uc77c\uc774 \ud544\uc694\ud55c \ubd80\uc704 \uac1c\uc120\uc5d0 \ub3c4\uc6c0<\/span><\/span><span style=\"color: #000000;\">\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8<\/span>\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p><em>\ud2b9\uc815 \ubd80\uc704\uac00 \uace0\ubbfc\uc774\ub77c\uba74, \uc190\uc8fc\uc0ac \ubcd1\ud589 \uc5ec\ubd80\ub97c \ud655\uc778\ud558\uc2dc\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/em><\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7244\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-1-1024x683.jpg\" alt=\"\" width=\"700\" height=\"467\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-1-1024x683.jpg 1024w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-1-300x200.jpg 300w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-1-768x512.jpg 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-1-800x533.jpg 800w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-1-900x600.jpg 900w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-1-675x450.jpg 675w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-1.jpg 1920w\" sizes=\"auto, (max-width: 700px) 100vw, 700px\" \/><\/p>\n<p>\ub9ac\uc96c\ub780\uc740 \uc5f0\uc5b4\uc5d0\uc11c \ucd94\ucd9c\ud55c \uc790\uc5f0\uc720\ub798 \uc131\ubd84\uc73c\ub85c \ud53c\ubd80\uc5d0 \ub4e4\uc5b4\uac00 <strong>\uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ubcc0\ud654\ub97c \uc774\ub04c\uc5b4\ub0b4\ub294 \uac83\uc774 \uac00\uc7a5 \ud070 \uc7a5\uc810<\/strong>\uc785\ub2c8\ub2e4. \uc774\ubbf8 \ub2e4\uc591\ud55c \uc784\uc0c1\uc774 \ucd95\uc801\ub418\uc5b4 \uc788\uace0, \uc785\uc18c\ubb38\uc744 \ud1b5\ud574 \uafb8\uc900\ud788 \ub9ce\uc740 \ubd84\ub4e4\uc774 \ucc3e\uc544\uc8fc\uace0 \uacc4\uc2ed\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p><strong>\uc911\uc694\ud55c \uc77c\uc744 \uc55e\ub450\uace0 \ud53c\ubd80\uc758 \ucd5c\uc801\uc758 \ucee8\ub514\uc158\uc744 \uc774\ub04c\uc5b4 \ub0b4\uace0 \uc2f6\uc740 \ubd84\ub4e4.<\/strong><\/p>\n<p><strong>\ud0c4\ub825\uc744 \uc783\uace0 \ud478\uc11d\ud478\uc11d\ud574\uc9c4 \ud53c\ubd80\uac00 \uace0\ubbfc\uc778 \ubd84\ub4e4.<\/strong><\/p>\n<p><strong>\uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uc548\ud2f0\uc5d0\uc774\uc9d5 \uad00\ub9ac\ub97c \uc6d0\ud558\ub294 \ubd84\ub4e4.<\/strong><\/p>\n<p>&nbsp;<\/p>\n<p>\uc624\ub298 \uc124\uba85 \ub4dc\ub9b0 \ub9ac\uc96c\ub780 \uc2dc\uc220\uc744<\/p>\n<p>\ud604\uc9c1\uc758\uc0ac\ub85c\uc11c, \ub610 \ub9ce\uc774 \ubc1b\uc544\ubcf8 \uacbd\ud5d8\uc790\ub85c\uc11c \uc790\uc2e0 \uc788\uac8c \ucd94\ucc9c\ub4dc\ub9bd\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>\uc624\ub298 \uae00\uc740 \ub9ac\uc96c\ub780\uacfc \ud568\uaed8 \ubcf8\uc6d0\uc758 \uc2dc\uc220\ubc29\ubc95\uc744 \uc124\uba85\ub4dc\ub9b0 \uae00\uc774\uc5c8\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ub354 \uad81\uae08\ud558\uc2e0 \uc810\uc774 \uc788\uc73c\uc2dc\ub2e4\uba74 \ud3b8\ud558\uac8c \ub0b4\uc6d0\ud574 \uc8fc\uc138\uc694.<br \/>\n\uc12c\uc138\ud558\uace0 \uaf3c\uaf3c\ud55c \uc9c4\ub8cc\ub85c \ubcf4\ub2f5\ud558\uaca0\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uac10\uc0ac\ud569\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n","protected":false},"excerpt":{"rendered":"<p>\uc548\ub155\ud558\uc138\uc694. \ub3d9\ud0c4\uc2a4\ub178\uc6b0\uc758\uc6d0 \uc758\ub8cc\uc9c4 \uc785\ub2c8\ub2e4. \ud604\uc9c1\uc5d0 \uc788\uc73c\uba74\uc11c \uc800\ub9cc\uc758 \ud790\ub9c1\uc774 \uc788\ub2e4\uba74, \ubc14\ub85c \ud1f4\uadfc \ud6c4 \uc2dc\uc220\uc744 \ubc1b\ub294 \uac83\uc778\ub370\uc694. \uadf8 \uc911\uc5d0\uc11c\ub3c4 \uac00\uc7a5 \uc560\uc815\ud558\ub294 \uc2dc\uc220\uc774 \uc788\ub2e4\uba74, 20\ub300\ubd80\ud130 \uc548\ud2f0\uc5d0\uc774\uc9d5\uc744 \uc704\ud574 \uafb8\uc900\ud788 \ubc1b\uc544\uc628 \uc774 \u2018\ub9ac\uc96c\ub780\u2019 \uc785\ub2c8\ub2e4. \ub9ac\uc96c\ub780\uc740&#8230;<\/p>\n","protected":false},"author":1,"featured_media":4393,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"om_disable_all_campaigns":false,"_monsterinsights_skip_tracking":false,"_monsterinsights_sitenote_active":false,"_monsterinsights_sitenote_note":"","_monsterinsights_sitenote_category":0,"footnotes":""},"categories":[10,15],"tags":[],"class_list":["post-4392","post","type-post","status-publish","format-standard","has-post-thumbnail","category-column","category-column_fix","front"],"aioseo_notices":[],"_links":{"self":[{"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/posts\/4392","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=%2Fwp%2Fv2%2Fcomments&post=4392"}],"version-history":[{"count":5,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/posts\/4392\/revisions"}],"predecessor-version":[{"id":7248,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/posts\/4392\/revisions\/7248"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/media\/4393"}],"wp:attachment":[{"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=%2Fwp%2Fv2%2Fmedia&parent=4392"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=%2Fwp%2Fv2%2Fcategories&post=4392"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=%2Fwp%2Fv2%2Ftags&post=4392"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}