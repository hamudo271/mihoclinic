{"id":4399,"date":"2023-11-28T16:00:27","date_gmt":"2023-11-28T07:00:27","guid":{"rendered":"https:\/\/snowdt.cafe24.com\/?p=4399"},"modified":"2025-12-22T16:46:40","modified_gmt":"2025-12-22T07:46:40","slug":"%ed%94%bc%ec%bd%94%ed%94%84%eb%9d%bd%ec%85%80-%eb%aa%a8%ea%b3%b5%ec%9d%80-%ea%b0%9c%ec%84%a0%ec%9d%b4-%ec%95%88%eb%90%9c%eb%8b%a4%eb%8a%94-%ed%8e%b8%ea%b2%ac%ec%9d%84-%ea%b9%a8-%eb%93%9c%eb%a6%bd","status":"publish","type":"post","link":"https:\/\/dongtan-snow.com\/?p=4399","title":{"rendered":"\ud53c\ucf54\ud504\ub77d\uc140, \ubaa8\uacf5\uc740 \uac1c\uc120\uc774 \uc548\ub41c\ub2e4\ub294 \ud3b8\uacac\uc744 \uae68 \ub4dc\ub9bd\ub2c8\ub2e4."},"content":{"rendered":"<p><strong><em><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7264\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ud53c\ucf54\ud504\ub77d\uc140-1024x1024.jpg\" alt=\"\" width=\"700\" height=\"700\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ud53c\ucf54\ud504\ub77d\uc140-1024x1024.jpg 1024w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ud53c\ucf54\ud504\ub77d\uc140-300x300.jpg 300w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ud53c\ucf54\ud504\ub77d\uc140-150x150.jpg 150w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ud53c\ucf54\ud504\ub77d\uc140-768x768.jpg 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ud53c\ucf54\ud504\ub77d\uc140-200x200.jpg 200w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ud53c\ucf54\ud504\ub77d\uc140-140x140.jpg 140w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ud53c\ucf54\ud504\ub77d\uc140-100x100.jpg 100w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ud53c\ucf54\ud504\ub77d\uc140-500x500.jpg 500w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ud53c\ucf54\ud504\ub77d\uc140-350x350.jpg 350w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ud53c\ucf54\ud504\ub77d\uc140-1000x1000.jpg 1000w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ud53c\ucf54\ud504\ub77d\uc140-800x800.jpg 800w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc12c\ub124\uc77c_\ud53c\ucf54\ud504\ub77d\uc140.jpg 1280w\" sizes=\"auto, (max-width: 700px) 100vw, 700px\" \/><\/em><\/strong><\/p>\n<p><strong><em>\u2018\ubaa8\uacf5\uc774 \uc88b\uc544\uc9c0\ub294 \uac83\uc740 \ubd88\uac00\ub2a5\ud55c\uac00\uc694?\u2019<\/em><\/strong><\/p>\n<p>&nbsp;<\/p>\n<p>\ubaa8\uacf5 \uc0ad\uc81c, \ubaa8\uacf5 \uc9c0\uc6b0\uac1c \ub4f1\uc758 \uc790\uadf9\uc801\uc778 \ub2e8\uc5b4\ub4e4\ub85c \ub9ce\uc740 \uc81c\ud488\ub4e4, \uc2dc\uc220\ub4e4\uc774 \ub098\uc640\uc788\uc9c0\ub9cc, \ub9c9\uc0c1 \uc8fc\ubcc0\uc5d0 \ud6a8\uacfc\ub97c \ubcf8 \uc0ac\ub78c\uc774 \ub9ce\uc9c0 \uc54a\uc740 \uac83\uc774 \ud604\uc2e4\uc774\uae30\ub3c4 \ud569\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p><strong>\u2018\uc758\ud559\uc758 \ubc1c\uc804\uc774 \uc544\uc9c1 \ub530\ub77c\uac00\uc9c0 \ubabb\ud558\uc5ec \ubaa8\uacf5\uc740 \ud574\uacb0\ud560 \uc218 \uc5c6\ub2e4.\u2019<\/strong> \ub77c\ub294 \uc18d\uc124\uc774 \ub9cc\uc5f0\ud560 \uc815\ub3c4\ub85c, \ubaa8\uacf5 \uc2dc\uc220\uc744 \ud558\uc600\uc73c\ub098 \ud070 \ub9cc\uc871\ub3c4\ub97c \ub290\ub07c\uc9c0 \ubabb\ud558\uace0 \ubc29\uce58\ud558\uace0 \uacc4\uc168\ub2e4\ub294 \ubd84\ub4e4\ub3c4 \ub9ce\uc774 \ubd50 \uc218 \uc788\uc5c8\uc2b5\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n<p>\uacfc\uac70\uc5d0\ub294 \ub2e4\uc591\ud55c \uce58\ub8cc\uc5d0\ub3c4 \uafc8\uca4d\ud558\uc9c0 \uc54a\ub294 \ubaa8\uacf5\uc758 \uac1c\uc120\uc744 \ub3c4\ubaa8\ud558\ub824\uba74 \ub354 \uac15\ud55c \uc5d0\ub108\uc9c0\ub85c \uc790\uadf9\uc744 \uac00\ud574\uc57c \ud55c\ub2e4\ub294 \ucee8\uc149\uc73c\ub85c \ub808\uc774\uc800\ubc15\ud53c \ub4f1\uc758 \uacf5\uaca9\uc801\uc778 \uc2dc\uc220\uc774 \uc720\ud589\ud588\ub358 \uc801\ub3c4 \uc788\uc5c8\uc2b5\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>\ud558\uc9c0\ub9cc, \uc774\ub294 \uc624\ud788\ub824 \ud53c\ubd80\ub97c \uc608\ubbfc\ud558\uac8c \ub9cc\ub4e4\uc5c8\uace0 \uc720\ud589\ub3c4 \uc2dc\ub4e4\uc5b4\uc838 \uac14\uc8e0.<\/p>\n<p>&nbsp;<\/p>\n<p>\uc774\ub97c \uadf9\ubcf5\ud558\uae30 \uc704\ud55c \ub9ce\uc740 \uace0\ubbfc\ub4e4 \ub05d\uc5d0 \uc0c8\ub85c\uc6b4 \uac1c\ub150\uc758 \uc2dc\uc220\uc774 \ub4f1\uc7a5\ud558\uac8c \ub418\ub294\ub370, \ubc14\ub85c <strong>\uadf8\uac83\uc774 \ud53c\ucf54\ud504\ub77d\uc140<\/strong> \uc785\ub2c8\ub2e4.<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7266\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\ud504\ub77d\uc140-1024x683.jpg\" alt=\"\" width=\"700\" height=\"467\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\ud504\ub77d\uc140-1024x683.jpg 1024w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\ud504\ub77d\uc140-300x200.jpg 300w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\ud504\ub77d\uc140-768x512.jpg 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\ud504\ub77d\uc140-800x533.jpg 800w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\ud504\ub77d\uc140-900x600.jpg 900w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\ud504\ub77d\uc140-675x450.jpg 675w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\ud504\ub77d\uc140.jpg 1920w\" sizes=\"auto, (max-width: 700px) 100vw, 700px\" \/><\/p>\n<p>\uc2ec\ud55c \uc5fc\uc99d, \uc790\uadf9, \ub178\ud654 \ub4f1\uc744 \uc774\uc720\ub85c, \ucf5c\ub77c\uac90, \uc5d8\ub77c\uc2a4\ud2f4\uacfc \uac19\uc740 \ud53c\ubd80\ub97c \uc9c0\ud0f1\ud574\uc8fc\ub294 \uad6c\uc131 \uc131\ubd84\uc758 \uc9c8\uacfc \uc591\uc774 \ub5a8\uc5b4\uc9c0\uac8c \ub418\uba70, \ubaa8\uacf5\uc744 \uc774\ub8e8\ub294 \ubcbd\uc740 \ud0c4\ub825\uc744 \uc783\uace0 \uc810\ucc28 \ub298\uc5b4\uc9c0\uac8c \ub429\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>\ub530\ub77c\uc11c, \uac1c\uc120\uc744 \uc704\ud574\uc11c\ub294 \ucf5c\ub77c\uac90, \uc5d8\ub77c\uc2a4\ud2f4\uc744 \uc2e0 \uc7ac\uc0dd\uc2dc\ucf1c \uc774 \ubcbd\uc744 \ud0c4\ud0c4\ud558\uac8c \ubcf5\uc6d0\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n<p>\uc0c1\ucc98\uc758 \uc815\uc0c1\uc801\uc778 \uc218\ubcf5 \uacfc\uc815\uc5d0\uc11c \ucf5c\ub77c\uac90, \uc5d8\ub77c\uc2a4\ud2f4\uc774 \uc0dd\uc131\ub418\ub294 \uac83\uc5d0 \ucc29\uc548\ud558\uc5ec, \ub9ce\uc740 \ubaa8\uacf5 \uce58\ub8cc\ub4e4\uc774 \ud53c\ubd80\uc5d0 \uc791\uc740 \uc0c1\ucc98\ub4e4\uc744 \ub0b4\uace0 \uc774\ub97c \ud68c\ubcf5\ud558\uba70 \uc6d0\ud558\ub294 \uacb0\uacfc\ub97c \ub0b4\ub3c4\ub85d \uc720\ub3c4\ud558\ub294\ub370\uc694.<\/p>\n<p>&nbsp;<\/p>\n<p>\uae30\uc874\uc758 \ubaa8\uacf5 \uce58\ub8cc\uc778 \ubc15\ud53c\uc131 \ud504\ub77d\uc140\uc740 \ud53c\ubd80 \ud45c\uba74\ubd80\ud130 \ubaa8\uacf5 \ubfcc\ub9ac\uae4c\uc9c0 \uc0c1\ucc98\ub97c \ub9cc\ub4e4\uc5b4 \ubcf5\uc6d0\uc744 \uc2dc\ud0a4\ub294 \ubc29\ubc95\uc73c\ub85c, \uacf5\uaca9\uc801\uc778 \ud14c\ud06c\ub2c9\uc778 \ub9cc\ud07c \ub9ce\uc740 \ubd80\uc791\uc6a9\uc744 \ub0b3\uae30\ub3c4 \ud588\uc2b5\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>\uc774\uc640 \ub2e4\ub974\uac8c, \ud53c\ucf54\ud504\ub77d\uc140\uc740 \uc548\ucabd\uc5d0 \ube54\uc5d0\ub108\uc9c0\ub97c \ubaa8\uc544 \ud53c\ubd80\ud45c\uba74\uc774 \uc544\ub2cc \ub0b4\ubd80\uc5d0\ub9cc \uc0c1\ucc98\ub97c \ub0b4\uae30 \ub54c\ubb38\uc5d0, <strong>\ud53c\ubd80 \uc790\uadf9\uc740 \ucd5c\uc18c\ud654\ud558\uba74\uc11c\ub3c4 \uac15\ub825\ud55c \uc870\uc9c1\ubc18\uc751\uc744 \uc774\ub044\ub294 \uc7a5\uc810<\/strong>\uc774 \uc788\ub2e4 \uc124\uba85\ub4dc\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7265\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-2-1024x683.jpg\" alt=\"\" width=\"700\" height=\"467\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-2-1024x683.jpg 1024w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-2-300x200.jpg 300w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-2-768x512.jpg 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-2-800x533.jpg 800w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-2-900x600.jpg 900w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-2-675x450.jpg 675w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uc804\ud6c4-2.jpg 1920w\" sizes=\"auto, (max-width: 700px) 100vw, 700px\" \/><\/p>\n<p>\uac19\uc740 \uc6d0\ub9ac\ub85c \uc774 \ud53c\ucf54\ud504\ub77d\uc140\uc740 <strong>\ud749\ud130\uce58\ub8cc<\/strong>\uc5d0\ub3c4 \uc4f0\uc774\uace0 \uc788\ub294\ub370\uc694.<\/p>\n<p>&nbsp;<\/p>\n<p>\uc2ec\ud55c \uc5ec\ub4dc\ub984\uc73c\ub85c \ubc1c\uc0dd\ud55c \ud30c\uc778 \ud749\ud130\uc758 \uacbd\uc6b0, \uc544\ubb34\ub294 \uacfc\uc815\uc5d0\uc11c \uc0dd\uae34 \uc12c\uc720\ud654\ub85c \uc778\ud558\uc5ec \uc815\uc0c1 \ud53c\ubd80\uac00 \ud568\ubab0\ub41c \ud615\ud0dc\ub85c \ubcfc \uc218 \uc788\ub294\ub370, \uc774 \ud53c\ucf54\ud504\ub77d\uc140\ub85c \uc548\ucabd\uc758 \uc12c\uc720\uc870\uc9c1\uc744 \ub04a\uc5b4 \uc90c\uc73c\ub85c\uc368 \uc774\ub97c \ud68c\ubcf5\uc2dc\ucf1c\uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n<p>\ud53c\ucf54\ud504\ub77d\uc140\uc740 pico \ucd08\uc758 \uc9e7\uc740 \uc870\uc0ac \uc2dc\uac04\uc744 \uad6c\ud604\ud558\ub294 \uae30\uc220\uc744 \uac00\uc9c4 \ud53c\ucf54\ub808\uc774\uc800\ub85c \uc9c4\ud589\ub429\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p> \uc800\ud76c \uc758\uc6d0\uc740 \uc218\ub9ce\uc740 \ud53c\ucf54\ub808\uc774\uc800 \uc911 \uce78\ub378\ub77c \uc0ac\uc758 \ud53c\ucf54\uc6e8\uc774\uc640 \uc0ac\uc774\ub178\uc288\uc5b4 \uc0ac\uc758 \ud53c\ucf54\uc288\uc5b4\ub97c \ubcf4\uc720\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>\uc9e7\uc740 \uc870\uc0ac \uc2dc\uac04\uc73c\ub85c \uac15\ub825\ud55c \ud53c\ud06c\ud30c\uc6cc\ub97c \uc0dd\uc131\ud560 \uc218 \uc788\ub294 \ub808\uc774\uc800 \uae30\uc220\ub85c, \uc791\uc740 \uc0c9\uc18c \uc785\uc790\ub3c4 \uc0b0\uc0b0\uc774 \uae68\ubd80\uc220 \uc218 \uc788\uc5b4 \ubb38\uc2e0\uc81c\uac70\uc5d0\ub3c4 \ub110\ub9ac \uc0ac\uc6a9\ub418\ub294 \ub808\uc774\uc800\uc785\ub2c8\ub2e4.<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7263\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2023\/11\/\uad00\ub9ac.gif\" alt=\"\" width=\"700\" height=\"467\" \/><\/p>\n<p><strong>\ubaa8\uacf5\uc758 \uc911\uc99d\ub3c4\ub098 \uc0c1\ucc98\uc758 \uae4a\uc774\uc5d0 \ub530\ub978 \uc800\ud76c \uc758\ub8cc\uc9c4\uc758 \uc12c\uc138\ud55c \ud14c\ud06c\ub2c9 \uc870\uc808<\/strong>\uc73c\ub85c \ub9ce\uc740 \ubd84\ub4e4\uaed8 \ucd5c\uc120\uc758 \uacb0\uacfc\ub97c \uc548\uaca8\ub4dc\ub9ac\uae30 \uc704\ud574 \ud56d\uc0c1 \uace0\ubbfc\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>\ubaa8\uacf5, \ud749\ud130, \uac1c\uc120\uc774 \ub420 \uc218 \uc5c6\ub2e4\ub294 \ud3b8\uacac\uc744 \uae68 \ub4dc\ub9ac\uae30 \uc704\ud574<\/p>\n<p><strong><em>\uc88b\uc740 \uc7a5\ube44<\/em><\/strong><\/p>\n<p><strong><em>\uaf3c\uaf3c\ud55c \uc2dc\uc220 <\/em><\/strong><\/p>\n<p><strong><em>\ubcd1\ubcc0 \ud2b9\uc131\uc744 \ud30c\uc545\ud55c \ub9de\ucda4 \uc811\uadfc\uc744 \uc9c0\ud5a5\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.<\/em><\/strong><\/p>\n<p>&nbsp;<\/p>\n<p>\ub9cc\uc871\uc2a4\ub7ec\uc6b4 \uacb0\uacfc\ub97c \uc548\uaca8\ub4dc\ub9ac\uae30 \uc704\ud574 \uc624\ub298\ub3c4 \ub178\ub825\ud558\uaca0\uc2b5\ub2c8\ub2e4. \uac10\uc0ac\ud569\ub2c8\ub2e4.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u2018\ubaa8\uacf5\uc774 \uc88b\uc544\uc9c0\ub294 \uac83\uc740 \ubd88\uac00\ub2a5\ud55c\uac00\uc694?\u2019 &nbsp; \ubaa8\uacf5 \uc0ad\uc81c, \ubaa8\uacf5 \uc9c0\uc6b0\uac1c \ub4f1\uc758 \uc790\uadf9\uc801\uc778 \ub2e8\uc5b4\ub4e4\ub85c \ub9ce\uc740 \uc81c\ud488\ub4e4, \uc2dc\uc220\ub4e4\uc774 \ub098\uc640\uc788\uc9c0\ub9cc, \ub9c9\uc0c1 \uc8fc\ubcc0\uc5d0 \ud6a8\uacfc\ub97c \ubcf8 \uc0ac\ub78c\uc774 \ub9ce\uc9c0 \uc54a\uc740 \uac83\uc774 \ud604\uc2e4\uc774\uae30\ub3c4 \ud569\ub2c8\ub2e4. &nbsp; \u2018\uc758\ud559\uc758 \ubc1c\uc804\uc774 \uc544\uc9c1&#8230;<\/p>\n","protected":false},"author":1,"featured_media":3732,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"om_disable_all_campaigns":false,"_monsterinsights_skip_tracking":false,"_monsterinsights_sitenote_active":false,"_monsterinsights_sitenote_note":"","_monsterinsights_sitenote_category":0,"footnotes":""},"categories":[10],"tags":[],"class_list":["post-4399","post","type-post","status-publish","format-standard","has-post-thumbnail","category-column","front"],"aioseo_notices":[],"_links":{"self":[{"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/posts\/4399","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=%2Fwp%2Fv2%2Fcomments&post=4399"}],"version-history":[{"count":5,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/posts\/4399\/revisions"}],"predecessor-version":[{"id":7303,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/posts\/4399\/revisions\/7303"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/media\/3732"}],"wp:attachment":[{"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=%2Fwp%2Fv2%2Fmedia&parent=4399"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=%2Fwp%2Fv2%2Fcategories&post=4399"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=%2Fwp%2Fv2%2Ftags&post=4399"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}