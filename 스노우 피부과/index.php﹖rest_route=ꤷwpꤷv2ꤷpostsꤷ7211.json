{"id":7211,"date":"2025-09-08T16:42:47","date_gmt":"2025-09-08T07:42:47","guid":{"rendered":"https:\/\/dongtan-snow.com\/?p=7211"},"modified":"2025-09-08T16:42:47","modified_gmt":"2025-09-08T07:42:47","slug":"%eb%8f%99%ed%83%84-%eb%a6%ac%ed%94%84%ed%8c%85-%ea%b3%a0%ec%a3%bc%ed%8c%8c-vs-%ec%b4%88%ec%9d%8c%ed%8c%8c-%eb%82%b4-%ec%96%bc%ea%b5%b4%ec%97%90-%eb%a7%9e%eb%8a%94-%ed%83%80%ec%9e%85%ec%9d%80","status":"publish","type":"post","link":"https:\/\/dongtan-snow.com\/?p=7211","title":{"rendered":"\ub3d9\ud0c4 \ub9ac\ud504\ud305, \uace0\uc8fc\ud30c vs \ucd08\uc74c\ud30c \ub0b4 \uc5bc\uad74\uc5d0 \ub9de\ub294 \ud0c0\uc785\uc740?"},"content":{"rendered":"<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7221\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc378\ub124\uc77c-1024x1024.jpg\" alt=\"\" width=\"700\" height=\"700\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc378\ub124\uc77c-1024x1024.jpg 1024w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc378\ub124\uc77c-300x300.jpg 300w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc378\ub124\uc77c-150x150.jpg 150w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc378\ub124\uc77c-768x768.jpg 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc378\ub124\uc77c-200x200.jpg 200w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc378\ub124\uc77c-140x140.jpg 140w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc378\ub124\uc77c-100x100.jpg 100w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc378\ub124\uc77c-500x500.jpg 500w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc378\ub124\uc77c-350x350.jpg 350w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc378\ub124\uc77c-1000x1000.jpg 1000w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc378\ub124\uc77c-800x800.jpg 800w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc378\ub124\uc77c.jpg 1280w\" sizes=\"auto, (max-width: 700px) 100vw, 700px\" \/><\/p>\n<p>\uc548\ub155\ud558\uc138\uc694.<br \/>\n\ub3d9\ud0c4\uc2a4\ub178\uc6b0\uc758\uc6d0 \uc758\ub8cc\uc9c4 \uc785\ub2c8\ub2e4.<\/p>\n<p>\uc624\ub298\uc740 \ud56d\ub178\ud654 \ud53c\ubd80 \uad00\ub9ac\uc5d0\uc11c \uc911\uc694\ud55c <strong>\ub9ac\ud504\ud305(Lifting)<\/strong>\uc5d0 \ub300\ud574 \uc774\uc57c\uae30\ud558\ub824 \ud569\ub2c8\ub2e4.<\/p>\n<p>\ud53c\ubd80\uac00 \uc911\ub825\uc5d0\ub3c4 \ud615\ud0dc\ub97c \uc720\uc9c0\ud560 \uc218 \uc788\ub294 \uc774\uc720\ub294 <span style=\"color: #333399;\">\uc9c4\ud53c \ud0c4\ub825\uacfc \ud53c\ubd80\ub97c \uc9c0\ud0f1\ud558\ub294 \uc778\ub300 \uac19\uc740 \uad6c\uc870<\/span> \ub355\ubd84\uc785\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>\uc880 \ub354 \uc26c\uc6b4 \uc811\uadfc\uc744 \uc704\ud574 \ucca0\uadfc\uacfc \ucf58\ud06c\ub9ac\ud2b8\ub85c \ube44\uc720\ud558\uc5ec \uc124\uba85\ub4dc\ub9ac\uaca0\uc2b5\ub2c8\ub2e4.<\/p>\n<p><strong>\ucf58\ud06c\ub9ac\ud2b8<\/strong>\ub85c \ube44\uc720\ub418\ub294 \ud53c\ubd80\ub294 <span style=\"color: #333399;\">\uc9c4\ud53c \uc790\uccb4\uc758 \ubc00\ub3c4\uac00 \ucd18\ucd18\ud574\uc57c \ud615\ud0dc\uac00 \uc720\uc9c0<\/span>\ub418\uba70,<\/p>\n<p><strong>\ucca0\uadfc<\/strong>\uc5d0 \ud574\ub2f9\ud558\ub294 \uadfc\ub9c9, \uc778\ub300 \ub4f1 <span style=\"color: #333399;\">\uc9c0\uc9c0 \uc870\uc9c1\uc774 \ud53c\ubd80\ub97c \ub2e8\ub2e8\ud788 \uacac\uc778\ud574\uc57c \ub298\uc5b4\uc9c0\uc9c0 \uc54a\uace0 \uacac\uace0\ud558\uac8c \uc720\uc9c0<\/span>\ub418\ub294 \uac83\uc785\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>\ub178\ud654\uac00 \uc9c4\ud589\ub418\uba70 \uc9c4\ud53c \ubc00\ub3c4\ub294 \uc904\uc5b4\ub4e4\uace0 \uc9c0\uc9c0 \uc870\uc9c1\uc740 \ub290\uc2a8\ud574\uc9c0\uae30 \ub54c\ubb38\uc5d0, <strong>\ub9ac\ud504\ud305 \uc2dc\uc220\ub4e4\uc740 \uc774\ub7ec\ud55c \ubcc0\ud654\ub97c \uadf9\ubcf5\ud558\uae30 \uc704\ud55c \ubc29\ud5a5<\/strong>\uc73c\ub85c \ubc1c\uc804\ud574\uc654\uc2b5\ub2c8\ub2e4.<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7219\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc288\ub9c1\ud06c-\uc804\ud6c4-1024x683.jpg\" alt=\"\" width=\"700\" height=\"467\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc288\ub9c1\ud06c-\uc804\ud6c4-1024x683.jpg 1024w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc288\ub9c1\ud06c-\uc804\ud6c4-300x200.jpg 300w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc288\ub9c1\ud06c-\uc804\ud6c4-768x512.jpg 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc288\ub9c1\ud06c-\uc804\ud6c4-800x533.jpg 800w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc288\ub9c1\ud06c-\uc804\ud6c4-900x600.jpg 900w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc288\ub9c1\ud06c-\uc804\ud6c4-675x450.jpg 675w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc288\ub9c1\ud06c-\uc804\ud6c4.jpg 1920w\" sizes=\"auto, (max-width: 700px) 100vw, 700px\" \/><br \/>\n\ub110\ub9ac \uc0ac\uc6a9\ub418\ub294 \ub9ac\ud504\ud305 \ubc29\uc2dd\uc740 <span style=\"color: #333399;\">\uace0\uc8fc\ud30c(RF)<\/span>\uc640 <span style=\"color: #333399;\">\ucd08\uc74c\ud30c(HIFU)<\/span>\ub85c \ub098\ub269\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<blockquote><p><strong>\uace0\uc8fc\ud30c \ub9ac\ud504\ud305<\/strong><\/p><\/blockquote>\n<p>\ub300\ud45c\uc801\uc778 \uc608\ub85c\ub294 <span style=\"color: #333399;\">\uc778\ubaa8\ub4dc, \uc368\ub9c8\uc9c0, \uc62c\ub9ac\uc9c0\uc624<\/span>\uac00 \uc788\uc73c\uba70, \ubcf8\uc6d0\uc5d0\uc11c\ub294<em> \uace0\uc8fc\ud30c \ubca0\uc774\uc2a4\uc5d0 \uace0\uc804\uc555 \uae30\uc220\uc744 \uacb0\ud569\ud55c \uc778\ubaa8\ub4dc \uc2dc\uc220\uc744 \uc9c4\ud589<\/em>\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<ul>\n<li>\uc9c4\ud53c \ub9ac\ubaa8\ub378\ub9c1\uc744 \uc720\ub3c4\ud558\uc5ec \ud53c\ubd80\ub97c \uacac\uace0\ud558\uac8c \uc7ac\ubc30\uce58<\/li>\n<li>\ub290\uc2a8\ud574\uc9c4 \uc9c0\uc9c0 \uc870\uc9c1\uc744 \ud0c0\uc774\ud2b8\ub2dd\ud558\uc5ec \ud53c\ubd80 \ucc98\uc9d0\uc744 \uac1c\uc120<\/li>\n<li>\ubd88\ud544\uc694\ud55c \uc9c0\ubc29 \uc138\ud3ec\ub97c \uc0ac\uba78\ud558\uace0 \ub77c\uc778\uc744 \uc815\ub9ac<\/li>\n<\/ul>\n<p>\uc9c0\ubc29\ub7c9\uc774 \ub9ce\uc73c\uba74 \uc9c0\uc9c0 \uc870\uc9c1\uc774 \ud53c\ubd80 \ubb34\uac8c\ub97c \uacac\ub514\uae30 \uc5b4\ub824\uc6cc \ucc98\uc9d0\uc774 \ub208\uc5d0 \ub744\uac8c \ub418\ub294\ub370, <span style=\"color: #333399;\">\uc778\ubaa8\ub4dc \uc2dc\uc220\uc740 \uc774\ub97c \uadfc\ubcf8\uc801\uc73c\ub85c \uac1c\uc120<\/span>\ud569\ub2c8\ub2e4.<\/p>\n<p>\uc5bc\uad74\uc5d0 \uc9c0\ubc29\uc774 \uc801\uc740 \uacbd\uc6b0\uc5d0\ub3c4 \uc778\ubaa8\ub4dc\ub294 \ubd88\ud544\uc694\ud55c \uc9c0\ubc29 \ub77c\uc778\uc744 \uc815\ub9ac\ud558\ub294 \uc815\ub3c4\ub85c \uc9c4\ud589\ub418\uae30 \ub54c\ubb38\uc5d0 \uacfc\ub3c4\ud55c \uc2dc\uc220\ub85c \uc778\ud55c \ubb38\uc81c\ub294 \uac70\uc758 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7218\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/KakaoTalk_20240513_090419256_01.gif\" alt=\"\" width=\"700\" height=\"467\" \/><\/p>\n<blockquote><p><strong>\ucd08\uc74c\ud30c \ub9ac\ud504\ud305<\/strong><\/p><\/blockquote>\n<p>\ub300\ud45c\uc801\uc778 \uc608\ub85c<span style=\"color: #333399;\"> \uc288\ub9c1\ud06c, \uc6b8\uc384\ub77c<\/span>\uac00 \uc788\uc73c\uba70, HIFU(High-Intensity Focused Ultrasound) \ubc29\uc2dd\uc73c\ub85c, \ucd08\uc74c\ud30c \uc5d0\ub108\uc9c0\ub97c \ud55c \uacf3\uc5d0 \uc9d1\uc911\uc2dc\ucf1c \ud53c\ubd80 \uc9c0\uc9c0 \uc870\uc9c1\uc744 \ud0c0\uc774\ud2b8\ub2dd\ud569\ub2c8\ub2e4.<\/p>\n<ul>\n<li>\uadfc\ub9c9\uc5d0 \uc5f4 \uc751\uace0\uc810\uc744 \ub9cc\ub4e4\uc5b4 \ud53c\ubd80\ub97c \uacac\uc778\ud558\ub294 \uc9c0\uc9c0\uc870\uc9c1\uc744 \ud0c0\uc774\ud2b8\ub2dd<\/li>\n<li>\uc5f4 \uc751\uace0\uc810 \uc8fc\ubcc0\uc73c\ub85c \uc9c4\ud53c \ub9ac\ubaa8\ub378\ub9c1\uc774 \ud568\uaed8 \ubc1c\uc0dd<\/li>\n<li>\ud55c \uc810 \ud55c \uc810 \uc5f4 \uc751\uace0\uc810\uc744 \ud615\uc131\ud558\uae30\uc5d0, \uc2dc\uc220 \uc704\uce58\uac00 \uacb0\uacfc\ub97c \uc88c\uc6b0<\/li>\n<\/ul>\n<p>\ubd88\ud544\uc694\ud55c \ubd80\uc704\uc5d0 \uacfc\ud55c \uc5f4 \uc751\uace0\uc810\uc774 \ubc1c\uc0dd\ud560 \uacbd\uc6b0, \ubbf8\ubb18\ud558\uac8c \uc778\uc0c1\uc774 \ubc14\ub00c\uba74\uc11c \ub9cc\uc871\ub3c4\uac00 \ub5a8\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uadf8\ub807\uae30 \ub54c\ubb38\uc5d0 <span style=\"color: #333399;\">\uc758\ub8cc\uc9c4\uc758 \uc12c\uc138\ud55c \ud14c\ud06c\ub2c9\uc774 \uc911\uc694<\/span>\ud558\uba70, <span style=\"color: #333399;\">\uc5b4\ub5a4 \ub514\uc790\uc778\uc774 \ub4e4\uc5b4\uac00\ub290\ub0d0\uc5d0 \ub530\ub77c \uc2dc\uc220\uc758 \uc131\ud328\ub97c \uc88c\uc6b0<\/span>\ud55c\ub2e4 \ub9d0\uc500\ub4dc\ub9b4 \uc218 \uc788\uaca0\uc2b5\ub2c8\ub2e4.<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7220\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc288\ub9c1\ud06c.jpg\" alt=\"\" width=\"700\" height=\"467\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc288\ub9c1\ud06c.jpg 900w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc288\ub9c1\ud06c-300x200.jpg 300w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc288\ub9c1\ud06c-768x512.jpg 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc288\ub9c1\ud06c-800x533.jpg 800w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc288\ub9c1\ud06c-675x450.jpg 675w\" sizes=\"auto, (max-width: 700px) 100vw, 700px\" \/><\/p>\n<p>\ubcf8\uc6d0\uc758 <strong>\uc288\ub9c1\ud06c \uc720\ub2c8\ubc84\uc2a4<\/strong>\ub294 <span style=\"color: #333399;\">MP\ubaa8\ub4dc\ub97c \uc801\uc6a9\ud574<\/span> <span style=\"color: #333399;\">\uae30\uc874 DOT\ubaa8\ub4dc\ubcf4\ub2e4 \uc5f4 \uc751\uace0\uc810\uc744 \uc120\ud615\uc73c\ub85c \uc870\ubc00\ud558\uac8c \ud615\uc131<\/span>\ud569\ub2c8\ub2e4.<\/p>\n<p>\uc810\uc774 \uc544\ub2cc \uc120\ud615 \ud0c0\uc785\uc73c\ub85c \uc870\uc9c1\uc758 \uc628\ub3c4\ub97c \ub192\uc774\uba70 <strong>\uc870\uae08 \ub354 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ub9ac\ud504\ud305\uacfc \uc9c4\ud53c \ud0c4\ub825 \uac1c\uc120\uc744 \uae30\ub300<\/strong>\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7222\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc778\ud14c\ub9ac\uc5b4.jpg\" alt=\"\" width=\"700\" height=\"467\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc778\ud14c\ub9ac\uc5b4.jpg 900w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc778\ud14c\ub9ac\uc5b4-300x200.jpg 300w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc778\ud14c\ub9ac\uc5b4-768x512.jpg 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc778\ud14c\ub9ac\uc5b4-800x533.jpg 800w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/09\/\uc778\ud14c\ub9ac\uc5b4-675x450.jpg 675w\" sizes=\"auto, (max-width: 700px) 100vw, 700px\" \/><br \/>\n\uc0ac\uc2e4 <span style=\"color: #333399;\">\uc288\ub9c1\ud06c<\/span>\uc640 <span style=\"color: #333399;\">\uc778\ubaa8\ub4dc<\/span>\ub294 \uc774\ubbf8 \ub9ac\ud504\ud305 \uc2dc\uc7a5\uc744 \uc810\ub839\ud588\ub2e4\uace0 \ud574\ub3c4 \uacfc\uc5b8\uc774 \uc544\ub2d9\ub2c8\ub2e4.<\/p>\n<p>\ud2b9\ud788 \uc288\ub9c1\ud06c\ub294 <em>\uc6b8\uc384\ub77c\ub97c \ubca4\uce58\ub9c8\ud0b9\ud55c \uad6d\uc0b0 \uc7a5\ube44<\/em>\ub85c \uc81c\uc870\uc0ac\uc778 \ud074\ub798\uc2dc\uc2a4\uc758 \uc8fc\uac00\ub97c \ub192\uc778 \uc8fc\uc778\uacf5\uc774\uae30\ub3c4 \ud569\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p><strong>\ucd5c\uadfc \uc80a\uc740 \uc5f0\ub839\uce35\uc5d0\uc11c\ub3c4 \ub9ac\ud504\ud305 \uc785\ubb38\uc774 \ud65c\ubc1c<\/strong>\ud574 \uc9c0\uba74\uc11c <span style=\"color: #333399;\">\uc774 \uac19\uc740 \uc2dc\uc220\ub4e4\uc774 \uc9c4\uac00\ub97c \ubc1c\ud718<\/span>\ud55c\ub2e4\uace0 \uc0dd\uac01\ud558\ub294\ub370\uc694.<\/p>\n<p>\uacfc\uac70\uc5d0 \ub098\uc774\uac00 \ub9ce\uc740 \ud658\uc790\uc5d0\uac8c\uc11c\ub9cc \uc2dc\ud589\ud558\ub358 <em>\uc548\uba74\uac70\uc0c1, \uc6b8\uc384\ub77c<\/em>\ubcf4\ub2e4<\/p>\n<p>\ud604\uc7ac <span style=\"color: #333399;\">\uc778\ubaa8\ub4dc, \uc288\ub9c1\ud06c<\/span> \ub4f1\uc744 \ud1b5\ud574 <strong>\uae30\ucd08\ubd80\ud130 \ud0c4\ud0c4\ud558\uac8c \ud53c\ubd80 \ud0c4\ub825\uc744 \uad00\ub9ac\ud558\ub294 \uac1c\ub150<\/strong>\uc73c\ub85c \uc80a\uc740\uce35\uc758 \uad00\uc2ec\uc774 \uafb8\uc900\ud788 \ub298\uace0 \uc788\ub294 \ucd94\uc138\ub77c\uace0 \ub9d0\uc500\ub4dc\ub9b4 \uc218 \uc788\uaca0\uc2b5\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>\ubcf8 \uae00\uc5d0\uc11c\ub294 \ub9ac\ud504\ud305 \uc2dc\uc220\uc758 \uc774\ud574\ub97c \ub3d5\uace0, \uc800\uc758 \uc0dd\uac01\uc744 \uc194\uc9c1\ud558\uac8c \ub9d0\uc500\ub4dc\ub9b0 \uae00\uc774\uc5c8\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ub354 \uad81\uae08\ud55c \uc810\uc774 \uc788\uc73c\uc2dc\ub2e4\uba74 \uc5b8\uc81c\ub4e0 \ub0b4\uc6d0\ud574 \uc8fc\uc138\uc694.<br \/>\n\uaf3c\uaf3c\ud55c \uc2dc\uc220\uacfc \ucd5c\uc120\uc744 \ub2e4\ud558\ub294 \ub9c8\uc74c\uc73c\ub85c \uc784\ud558\uaca0\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uac10\uc0ac\ud569\ub2c8\ub2e4.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>\uc548\ub155\ud558\uc138\uc694. \ub3d9\ud0c4\uc2a4\ub178\uc6b0\uc758\uc6d0 \uc758\ub8cc\uc9c4 \uc785\ub2c8\ub2e4. \uc624\ub298\uc740 \ud56d\ub178\ud654 \ud53c\ubd80 \uad00\ub9ac\uc5d0\uc11c \uc911\uc694\ud55c \ub9ac\ud504\ud305(Lifting)\uc5d0 \ub300\ud574 \uc774\uc57c\uae30\ud558\ub824 \ud569\ub2c8\ub2e4. \ud53c\ubd80\uac00 \uc911\ub825\uc5d0\ub3c4 \ud615\ud0dc\ub97c \uc720\uc9c0\ud560 \uc218 \uc788\ub294 \uc774\uc720\ub294 \uc9c4\ud53c \ud0c4\ub825\uacfc \ud53c\ubd80\ub97c \uc9c0\ud0f1\ud558\ub294 \uc778\ub300 \uac19\uc740 \uad6c\uc870 \ub355\ubd84\uc785\ub2c8\ub2e4. &nbsp; \uc880&#8230;<\/p>\n","p