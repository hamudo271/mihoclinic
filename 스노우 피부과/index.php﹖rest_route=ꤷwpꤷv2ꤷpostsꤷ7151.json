{"id":7151,"date":"2025-08-28T17:00:10","date_gmt":"2025-08-28T08:00:10","guid":{"rendered":"https:\/\/dongtan-snow.com\/?p=7151"},"modified":"2025-08-29T18:00:42","modified_gmt":"2025-08-29T09:00:42","slug":"%eb%8f%99%ed%83%84%eb%ac%b8%ec%8b%a0%ec%a0%9c%ea%b1%b0-%ed%94%bc%ec%bd%94%ec%9b%a8%ec%9d%b4-vs-%ed%94%bc%ec%bd%94%ec%8a%88%ec%96%b4-%ec%b0%a8%ec%9d%b4-%ec%a0%95%eb%a6%ac","status":"publish","type":"post","link":"https:\/\/dongtan-snow.com\/?p=7151","title":{"rendered":"\ub3d9\ud0c4\ubb38\uc2e0\uc81c\uac70, \ud53c\ucf54\uc6e8\uc774 vs \ud53c\ucf54\uc288\uc5b4 \ucc28\uc774 \uc815\ub9ac"},"content":{"rendered":"<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7159\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\uba54\uc778\uc774\ubbf8\uc9c0-1024x1024.jpg\" alt=\"\" width=\"700\" height=\"700\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\uba54\uc778\uc774\ubbf8\uc9c0-1024x1024.jpg 1024w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\uba54\uc778\uc774\ubbf8\uc9c0-300x300.jpg 300w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\uba54\uc778\uc774\ubbf8\uc9c0-150x150.jpg 150w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\uba54\uc778\uc774\ubbf8\uc9c0-768x768.jpg 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\uba54\uc778\uc774\ubbf8\uc9c0-200x200.jpg 200w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\uba54\uc778\uc774\ubbf8\uc9c0-140x140.jpg 140w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\uba54\uc778\uc774\ubbf8\uc9c0-100x100.jpg 100w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\uba54\uc778\uc774\ubbf8\uc9c0-500x500.jpg 500w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\uba54\uc778\uc774\ubbf8\uc9c0-350x350.jpg 350w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\uba54\uc778\uc774\ubbf8\uc9c0-1000x1000.jpg 1000w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\uba54\uc778\uc774\ubbf8\uc9c0-800x800.jpg 800w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\uba54\uc778\uc774\ubbf8\uc9c0.jpg 1280w\" sizes=\"auto, (max-width: 700px) 100vw, 700px\" \/><\/p>\n<p>&nbsp;<\/p>\n<p>\uc548\ub155\ud558\uc138\uc694.<br \/>\n\ub3d9\ud0c4\uc2a4\ub178\uc6b0\uc758\uc6d0 \uc758\ub8cc\uc9c4\uc785\ub2c8\ub2e4.<\/p>\n<p>\uc800\ud76c\ub294 \ub0b4\uc6d0\ud574\uc8fc\uc2e0 \ud658\uc790\ubd84\ub4e4\uaed8 \ub354 \ub098\uc740 \uacb0\uacfc\ub97c \ub4dc\ub9ac\uae30 \uc704\ud574 \ub298 \uace0\ubbfc\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \ubb38\uc2e0 \uc81c\uac70\ub294 \ub2e4\ub978 \uce58\ub8cc\uc5d0 \ube44\ud574 \uc5ec\ub7ec \ucc28\ub840\uc758 \uc2dc\uc220\uc774 \ud544\uc694\ud55c \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uadf8\ub807\uae30\uc5d0 \ud55c \ubc88\uc744 \uc9c4\ud589\ud558\ub354\ub77c\ub3c4 \ud6a8\uacfc\uc801\uc73c\ub85c \uc774\ub8e8\uc5b4\uc9c0\ub294 \uac83\uc774 \uc911\uc694\ud558\ub2e4\uace0 \uc0dd\uac01\ud569\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7161\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-1-1024x704.jpg\" alt=\"\" width=\"700\" height=\"481\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-1-1024x704.jpg 1024w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-1-300x206.jpg 300w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-1-768x528.jpg 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-1.jpg 1600w\" sizes=\"auto, (max-width: 700px) 100vw, 700px\" \/><\/p>\n<p>\uc774\ub7ec\ud55c \uace0\ubbfc \ub05d\uc5d0 \uc800\ud76c\ub294 \ucd5c\uadfc \u2018<strong>\ud53c\ucf54\uc6e8\uc774(Picoway)<\/strong>\u2019\ub77c\ub294 \uc7a5\ube44\ub97c \uc0c8\ub86d\uac8c \ub3c4\uc785\ud558\uac8c \ub418\uc5c8\uace0, \uc774\uc5d0 \ub300\ud574 \uc124\uba85\ub4dc\ub9ac\ub824\uace0 \ud569\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>\ud53c\ucf54\uc6e8\uc774\ub294 \ubbf8\uad6d\uc758 \ub300\ud45c\uc801\uc778 \ubb38\uc2e0 \uc81c\uac70 \uc804\ubb38\ubcd1\uc6d0\uc778 Invisible Ink Tattoo Removers\uc5d0\uc11c \ub3c5\uc810\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \uc7a5\ube44\ub85c\ub3c4 \uc798 \uc54c\ub824\uc838 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uadf8\ub3d9\uc548 \uc800\ud76c\ub294 \ubbf8\uad6d \uc0ac\uc774\ub178\uc288\uc5b4\uc0ac\uc758 <strong>\ud53c\ucf54\uc288\uc5b4(Picosure)<\/strong>\ub97c \uc774\uc6a9\ud574 \ubb38\uc2e0 \uc81c\uac70\ub97c \uc9c4\ud589\ud574\uc654\uc2b5\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>\ud558\uc9c0\ub9cc \uc2e4\uc81c \uc784\uc0c1\uc5d0\uc11c \ub2e4\uc591\ud55c \uc0c9\uc0c1\u00b7\ub18d\ub3c4\u00b7\uae4a\uc774\ub97c \uac00\uc9c4 \ubb38\uc2e0\uc744 \uce58\ub8cc\ud558\uba74\uc11c, \ub354 \uc138\ubd84\ud654\ub41c \ub9de\ucda4 \uce58\ub8cc\uac00 \ud544\uc694\ud558\ub2e4\uace0 \ub290\ub07c\uac8c \ub418\uc5c8\uace0, \uc5ec\ub7ec \uc7a5\ube44\ub97c \uac80\ud1a0\ud55c \ub05d\uc5d0<span style=\"color: #333399;\"> \ud53c\ucf54\uc288\uc5b4\uc640 \ud568\uaed8 \uc0ac\uc6a9\ud558\uae30\uc5d0 \uc801\ud569\ud55c \ud30c\ud2b8\ub108\ub85c \ud53c\ucf54\uc6e8\uc774\ub97c \uc120\ud0dd<\/span>\ud558\uac8c \ub418\uc5c8\uc2b5\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n<p><strong><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7046\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/05\/1-1024x563.jpg\" alt=\"\" width=\"700\" height=\"385\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/05\/1-1024x563.jpg 1024w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/05\/1-300x165.jpg 300w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/05\/1-768x422.jpg 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/05\/1.jpg 2000w\" sizes=\"auto, (max-width: 700px) 100vw, 700px\" \/><\/strong>\ubcf8 \uc804\ud6c4\uc0ac\uc9c4\uc740 \ub3d9\ud0c4\uc2a4\ub178\uc6b0\uc758\uc6d0\uc5d0\uc11c \uc2e4\uc81c \uc2dc\uc220\uc744 \ubc1b\uc740 \uace0\uac1d\uc758 \uc804\ud6c4 \uc0ac\uc9c4\uc774\uba70, \uc2e0\uc0c1 \ubcf4\ud638\ub97c \uc704\ud55c \ubaa8\uc790\uc774\ud06c \uc678 \ub2e4\ub978 \ubcf4\uc815\uc740 \ud558\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4.<br \/>\n\ub610\ud55c \ub808\uc774\uc800 \uc2dc\uc220 \uc2dc \uc5fc\uc99d, \ud654\uc0c1, \uc0c9\uc18c\uce68\ucc29 \ub4f1 \ubd80\uc791\uc6a9\uc774 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc74c\uc744 \uc758\ub8cc\ubc95\uc5d0 \ub530\ub77c \uc548\ub0b4\ub4dc\ub9bd\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<blockquote><p><strong>&#8216;\ubb38\uc2e0\uc81c\uac70\uac00 \uc624\ub798 \uac78\ub9ac\ub294 \uc774\uc720&#8217;<\/strong><\/p><\/blockquote>\n<p>\ubb38\uc2e0\uc774 \uc5bc\ub9c8\ub098 \ube68\ub9ac \uc605\uc5b4\uc9c0\ub294\uc9c0\ub294 \uc5ec\ub7ec \uc694\uc778\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4.<\/p>\n<ol>\n<li><span style=\"color: #333399;\">\ud53c\ubd80\ud1a4<\/span>\uc774 \uc5b4\ub450\uc6b4 \uacbd\uc6b0<\/li>\n<li><span style=\"color: #333399;\">\uc190\u00b7\ubc1c\ub05d\ucc98\ub7fc \ub9d0\ub2e8 \ubd80\uc704<\/span>\uc5d0 \uc704\uce58\ud55c \uacbd\uc6b0<\/li>\n<li>\ubb38\uc2e0 \uacfc\uc815\uc5d0\uc11c <span style=\"color: #333399;\">\ud749\ud130\uac00 \uc0dd\uaca8 \ud53c\ubd80 \ud45c\uba74\uc774 \uc6b8\ud241\ubd88\ud241<\/span>\ud55c \uacbd\uc6b0<\/li>\n<\/ol>\n<p>&nbsp;<\/p>\n<p>\ub610\ud55c \ubb38\uc2e0 \uc790\uccb4\uc758 \ud2b9\uc131\ub3c4 \uc601\ud5a5\uc744 \uc90d\ub2c8\ub2e4.<\/p>\n<p>\uc789\ud06c\uac00 \uc9c4\ud558\uac8c \ucc44\uc6cc\uc84c\uac70\ub098, \ucee4\ubc84\uc5c5\uc744 \ud588\uac70\ub098, \ud750\ub824\uc9c4 \ubb38\uc2e0 \uc704\uc5d0 \ub367\uc785\ud78c \uacbd\uc6b0 \uce58\ub8cc \uae30\uac04\uc774 \uae38\uc5b4\uc9d1\ub2c8\ub2e4. \uc5ec\ub7ec \uc0c9\uc0c1\uc774 \ud63c\ud569\ub41c \ubb38\uc2e0 \uc5ed\uc2dc \ub09c\uc774\ub3c4\uac00 \ub192\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uc774\ub85c \uc778\ud574 \ub9ce\uc740 \ubd84\ub4e4\uc774 \uc7a6\uc740 \ub0b4\uc6d0\uacfc \ub290\ub9b0 \uacbd\uacfc \ub54c\ubb38\uc5d0 \uce58\ub8cc\ub97c \uc911\ub2e8\ud558\uac70\ub098 \uc544\uc608 \uc2dc\uc791\uc744 \ub9dd\uc124\uc774\ub294 \uacbd\uc6b0\ub3c4 \ub9ce\uc2b5\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p><strong><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-7160\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-\ud53c\ucf54\uc288\uc5b4-1024x1024.jpg\" alt=\"\" width=\"700\" height=\"700\" srcset=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-\ud53c\ucf54\uc288\uc5b4-1024x1024.jpg 1024w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-\ud53c\ucf54\uc288\uc5b4-300x300.jpg 300w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-\ud53c\ucf54\uc288\uc5b4-150x150.jpg 150w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-\ud53c\ucf54\uc288\uc5b4-768x768.jpg 768w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-\ud53c\ucf54\uc288\uc5b4-200x200.jpg 200w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-\ud53c\ucf54\uc288\uc5b4-140x140.jpg 140w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-\ud53c\ucf54\uc288\uc5b4-100x100.jpg 100w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-\ud53c\ucf54\uc288\uc5b4-500x500.jpg 500w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-\ud53c\ucf54\uc288\uc5b4-350x350.jpg 350w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-\ud53c\ucf54\uc288\uc5b4-1000x1000.jpg 1000w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-\ud53c\ucf54\uc288\uc5b4-800x800.jpg 800w, https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud53c\ucf54\uc6e8\uc774-\ud53c\ucf54\uc288\uc5b4.jpg 2000w\" sizes=\"auto, (max-width: 700px) 100vw, 700px\" \/><\/strong><\/p>\n<blockquote><p><strong>&#8216;\uc2dc\uc220 \uc7a5\ube44 \ubc0f \ud30c\uc7a5\uc774 \uc911\uc694&#8217;<\/strong><\/p><\/blockquote>\n<p>\uc644\ubcbd\ud558\uac8c 2~3\ud68c \ub9cc\uc5d0 \ubb38\uc2e0\uc774 \uc0ac\ub77c\uc9c4\ub2e4\uace0 \ub9d0\uc500\ub4dc\ub9b4 \uc218\ub294 \uc5c6\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uadf8\ub7ec\ub098 \uc7a5\ube44\uc758 \uc2a4\ud399\ud2b8\ub7fc(\ud30c\uc7a5 \ub2e4\uc591\uc131)\uacfc \uc2dc\uc220\uc790\uc758 \ud14c\ud06c\ub2c9\uc5d0 \ub530\ub77c \uce58\ub8cc \uae30\uac04\uc744 \uc904\uc774\uace0 \ud6a8\uc728\uc801\uc778 \uacb0\uacfc\ub97c \uae30\ub300\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<ul>\n<li>\ud53c\ucf54\uc288\uc5b4 : 755nm \ud30c\uc7a5<\/li>\n<li>\ud53c\ucf54\uc6e8\uc774 : 532nm, 730nm, 1064nm \ud30c\uc7a5<\/li>\n<\/ul>\n<p>&nbsp;<\/p>\n<p>\ud30c\uc7a5\uc5d0 \ub530\ub77c \uc798 \uc9c0\uc6cc\uc9c0\ub294 \uc789\ud06c \uc0c9\uc0c1\uc774 \ub2e4\ub985\ub2c8\ub2e4.<\/p>\n<ul>\n<li>532nm \u2192 <span style=\"color: #333399;\">\ubd89\uc740\uc0c9 \uacc4\uc5f4<\/span>\uc5d0 \ud6a8\uacfc\uc801<\/li>\n<li>730nm \/ 755nm \u2192 <span style=\"color: #333399;\">\uccad\uc0c9\u00b7\uac80\uc815\uc0c9 \uc789\ud06c<\/span>\uc5d0 \ubc18\uc751<\/li>\n<li>1064nm \u2192 <span style=\"color: #333399;\">\ud53c\ubd80 \uae4a\uc219\ud55c \uacf3\uc5d0 \uce68\ucc29<\/span>\ub41c \uc624\ub798\ub41c \ubb38\uc2e0 \uc81c\uac70\uc5d0 \uc720\ub9ac<\/li>\n<\/ul>\n<p>&nbsp;<\/p>\n<p>\uc989, \uc774\ucc98\ub7fc <strong>\ub2e4\uc591\ud55c \ud30c\uc7a5\uc744 \ud65c\uc6a9\ud574 \ubb38\uc2e0\uc758 \uc0c9\u00b7\uae4a\uc774\uc5d0 \ub9de\ucd98 \uac1c\ubcc4\ud654 \uce58\ub8cc\uac00 \uac00\ub2a5\ud558\ub2e4<\/strong>\ub294 \uc7a5\uc810\uc774 \uc788\uae30\uc5d0 \ud53c\ucf54\uc6e8\uc774, \ud53c\ucf54\uc288\uc5b4 \ub450 \uac1c\uc758 \ud558\uc774\uc5d4\ub4dc \uc7a5\ube44\ub97c \uc774\uc6a9\ud558\uac8c \ub418\uc5c8\uc2b5\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p><strong><img loading=\"lazy\" decoding=\"async\" class=\"size-full wp-image-7162 aligncenter\" src=\"https:\/\/dongtan-snow.com\/wp-content\/uploads\/2025\/08\/\ud3b8\uc9d11.gif\" alt=\"\" width=\"742\" height=\"594\" \/><\/strong><\/p>\n<blockquote><p><strong>&#8216;\ud504\ub799\ud0c0\ud2b8 : FracTat \uae30\ubc95&#8217;<\/strong><\/p><\/blockquote>\n<p>\uc800\ud76c\ub294 \uc7a5\ube44\ubfd0 \uc544\ub2c8\ub77c \uae30\ubc95\uc5d0\uc11c\ub3c4 \ucc28\ubcc4\ud654\ub97c \ub450\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub300\ud45c\uc801\uc778 \ubc29\ubc95\uc774<span style=\"color: #333399;\"> **\ud504\ub799\ud0c0\ud2b8(FracTat)**<\/span>\uc785\ub2c8\ub2e4.<\/p>\n<p>\uc77c\ubc18\uc801\uc73c\ub85c \ub808\uc774\uc800 \uc870\uc0ac \uc9c1\ud6c4 \ud558\uc597\uac8c \ub9c9\uc774 \uc0dd\uae30\ub294\ub370, \uc774\ub294 \ucd94\uac00 \uc870\uc0ac \uc2dc \uc5d0\ub108\uc9c0\uac00 \uae4a\uc774 \uc804\ub2ec\ub418\ub294 \uac83\uc744 \ubc29\ud574\ud569\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>\ud504\ub799\ud0c0\ud2b8 \uae30\ubc95\uc740 Fractional \uc870\uc0ac\ub85c \uba3c\uc800 \ud45c\uba74\uc744 \uc5f4\uace0, \uc774\uc5b4\uc11c \ud480\uc0f7\uc73c\ub85c \uc870\uc0ac\ud558\uc5ec \uc789\ud06c\ub97c \ub450 \ubc88 \ud0c0\uaca9\ud558\ub294 \ubc29\uc2dd\uc73c\ub85c \ub354 \ud6a8\uacfc\uc801\uc774\uace0 \ud6a8\uc728\uc801\uc778 \uc81c\uac70\uac00 \uac00\ub2a5\ud569\ub2c8\ub2e4.<\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n<p>\uc774\ubc88 \uae00\uc5d0\uc11c\ub294 \ud53c\ucf54\uc6e8\uc774\uc640 \ud53c\ucf54\uc288\uc5b4\uc758 \ucc28\uc774, \uadf8\ub9ac\uace0 \ud6a8\uacfc\uc801\uc778 \ubb38\uc2e0 \uc81c\uac70\ub97c \uc704\ud55c \uc800\ud76c\uc758 \uc811\uadfc \ubc29\uc2dd\uc744 \uc18c\uac1c\ud574\ub4dc\ub838\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ub354 \uad81\uae08\ud55c \uc810\uc774 \uc788\uc73c\uc2dc\ub2e4\uba74 \uc5b8\uc81c\ub4e0 \ub0b4\uc6d0\ud574 \uc8fc\uc138\uc694.<br \/>\n\ud56d\uc0c1 \uaf3c\uaf3c\ud55c \uc9c4\ub8cc\uc640 \uc88b\uc740 \uacb0\uacfc\ub97c \uc704\ud574 \ucd5c\uc120\uc744 \ub2e4\ud558\uaca0\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uac10\uc0ac\ud569\ub2c8\ub2e4.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>&nbsp; \uc548\ub155\ud558\uc138\uc694. \ub3d9\ud0c4\uc2a4\ub178\uc6b0\uc758\uc6d0 \uc758\ub8cc\uc9c4\uc785\ub2c8\ub2e4. \uc800\ud76c\ub294 \ub0b4\uc6d0\ud574\uc8fc\uc2e0 \ud658\uc790\ubd84\ub4e4\uaed8 \ub354 \ub098\uc740 \uacb0\uacfc\ub97c \ub4dc\ub9ac\uae30 \uc704\ud574 \ub298 \uace0\ubbfc\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \ubb38\uc2e0 \uc81c\uac70\ub294 \ub2e4\ub978 \uce58\ub8cc\uc5d0 \ube44\ud574 \uc5ec\ub7ec \ucc28\ub840\uc758 \uc2dc\uc220\uc774 \ud544\uc694\ud55c \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \uadf8\ub807\uae30\uc5d0 \ud55c \ubc88\uc744&#8230;<\/p>\n","protected":false},"author":9,"featured_media":7157,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"om_disable_all_campaigns":false,"_monsterinsights_skip_tracking":false,"_monsterinsights_sitenote_active":false,"_monsterinsights_sitenote_note":"","_monsterinsights_sitenote_category":0,"footnotes":""},"categories":[10],"tags":[],"class_list":["post-7151","post","type-post","status-publish","format-standard","has-post-thumbnail","category-column","front"],"aioseo_notices":[],"_links":{"self":[{"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/posts\/7151","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/users\/9"}],"replies":[{"embeddable":true,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=%2Fwp%2Fv2%2Fcomments&post=7151"}],"version-history":[{"count":5,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/posts\/7151\/revisions"}],"predecessor-version":[{"id":7169,"href":"https:\/\/dongtan-snow.com\/index.php?rest_route=\/wp\/v2\/posts\/7151\/revisions\/7169"}],"wp:featuredmedia":[{"embedda